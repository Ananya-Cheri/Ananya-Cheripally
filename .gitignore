# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# ---- secrets: never commit these ----
# environment variables (API keys, tokens, passwords)
.env*
!.env.example
# keys, certificates and credential files
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
*secret*
*credentials*
service-account*.json

# vercel (project link + pulled env vars)
.vercel

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS files
.DS_Store
Thumbs.db

# editor & tool settings
.vscode/
.idea/
*.swp
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
